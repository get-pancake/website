# Open roadmap — backend + auth config.
# Copy to .env.local for local dev, and set the same vars in Vercel
# (Project → Settings → Environment Variables). Without the Supabase vars, the
# roadmap renders in read-only "preview mode" from static seed data.

# ── Supabase (roadmap data: ideas + votes) ───────────────────────────────────
# Public (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only — NEVER expose. Used by API routes to write (create/vote/delete).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Admin auth (delete) — Google sign-in ─────────────────────────────────────
# Admins sign in with Google on the hidden /open-roadmap/admin page; only
# verified emails on the allow-listed domain(s) get admin (reveals delete).
#
# Google OAuth 2.0 credentials (APIs & Services → Credentials → OAuth client ID,
# type "Web application"). Add this authorised redirect URI for each origin:
#   http://localhost:3001/api/roadmap/auth/google/callback   (local dev)
#   https://www.getpancake.ai/api/roadmap/auth/google/callback (production)
GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-client-secret
# Secret used to sign the admin session cookie. Generate with: openssl rand -hex 32
ROADMAP_AUTH_SECRET=replace-with-a-long-random-secret
# Comma-separated allow-list of email domains (optional; defaults to getpancake.ai).
# ROADMAP_ALLOWED_EMAIL_DOMAINS=getpancake.ai
# Override the OAuth redirect URI if auto-detection from the request is wrong
# (e.g. behind an unusual proxy). Must exactly match a URI registered above.
# ROADMAP_OAUTH_REDIRECT_URI=https://www.getpancake.ai/api/roadmap/auth/google/callback

# ── Free AI GTM report (/report + /api/report) ───────────────────────────────
# Required — powers the single Claude analysis call of every scan.
ANTHROPIC_API_KEY=sk-ant-your-key
# Optional model override (default claude-haiku-4-5; try claude-sonnet-5 if
# buyer-prompt quality underwhelms).
# ANTHROPIC_MODEL=claude-haiku-4-5
# Optional — real Google rankings + real ChatGPT citation checks (DataForSEO).
# Without these the scan runs in "estimated" mode off Claude's own judgment.
# DATAFORSEO_LOGIN=you@example.com
# DATAFORSEO_PASSWORD=your-dataforseo-password
# DATAFORSEO_CHATGPT_MODEL=gpt-4o-mini
# Spend levers: global fresh-scan budget per day (per instance) and how many
# of the 10 buyer prompts get a live ChatGPT check per scan.
# REPORT_DAILY_SCAN_CAP=200
# REPORT_PROMPTS_TO_CHECK=10
# The email gate reuses the waitlist backend.
AIRTABLE_TOKEN=your-airtable-personal-access-token
AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX
# Generate once with `openssl rand -hex 32`, store only server-side, and keep it
# stable: changing it changes every opaque waitlist conversion ID.
ANALYTICS_EVENT_ID_SECRET=replace-with-at-least-32-random-characters
# Optional best-effort notification. Create the webhook against #signups.
# SLACK_WAITLIST_WEBHOOK_URL=https://hooks.slack.com/services/...

# ── Meta Conversions API (server-only analytics) ─────────────────────────────
# Used only by the origin-checked waitlist API after Airtable accepts an eligible
# v2 row. Set the real token in Vercel; never expose it as NEXT_PUBLIC_*.
META_PIXEL_ID=3496980123812649
META_CONVERSIONS_API_ACCESS_TOKEN=your-meta-conversions-api-token
META_GRAPH_API_VERSION=v25.0
# Explicit production activation gate. Leave false until browser/server Test
# Events share one event ID and Meta reports the pair as deduplicated.
META_CAPI_LEAD_MATCHING_ENABLED=false
# Optional: Events Manager → Test events. Remove this in production.
# META_TEST_EVENT_CODE=TEST12345

# ── Demo requests (/demo + /api/demo-request) ────────────────────────────────
# Where a demo request lands. In production at least one delivery must succeed
# or the route answers 503 and the page asks the visitor to retry. Locally,
# with none configured, the route logs a notice and answers 200 so the
# form can be exercised end to end.
# Slack incoming webhook for demo requests. In production only, unset falls
# back to SLACK_WAITLIST_WEBHOOK_URL (#signups); in development it never does,
# so local QA cannot post to #signups. To see a real Slack message locally, set
# this to a test hook. Vercel Preview deployments run with NODE_ENV=production:
# add SLACK_DEMO_WEBHOOK_URL (a test hook) to the Preview environment before
# browser QA on a PR preview, or the preview posts to #signups via the fallback
# (or answers 503 when that is unset for Preview).
# SLACK_DEMO_WEBHOOK_URL=https://hooks.slack.com/services/...
# Airtable table for demo requests, in the same base as the waitlist (uses
# AIRTABLE_TOKEN / AIRTABLE_BASE_ID above). Create the table with these fields:
# First name, Last name, Email, Website, Team size (single select: 1-2 / 3-20 /
# 21-50 / 51+, the Calendly routing form's buckets since 2026-09-16; rows from
# before carry 3-10 / 11-50 / 51-200 / 201+), Has account (single select: Yes /
# No), Goal (single select), Source, Submitted At (date with time), Attribution
# ID, Submission ID (single line text: the route upserts on it, so it must
# exist). Select options are created on first write.
# AIRTABLE_DEMO_REQUESTS_TABLE_ID=tblXXXXXXXXXXXXXX
# Attio (the CRM) for demo requests (lib/attio-demo-request.ts): each request
# finds or creates the Person by email (only empty name / company fields are
# filled on an existing person), the Company by the website's domain, and adds
# the answers as a note on the person. Never touches Deals. A workspace access
# token (Attio > Workspace settings > Developers) with the scopes
# record_permission:read-write, object_configuration:read and note:read-write.
# Set it in Production only unless you want Preview QA leads in the CRM.
# ATTIO_API_KEY=your-attio-access-token
# Optional: the ElevenLabs agent behind "Talk to AI sales" on the booking
# state. Unset = the id in lib/ai-sales.ts (ElevenLabs workspace, agent
# "[WEBSITE] AI sales", published 2026-09-16). It is a PUBLIC agent id, not a
# secret (no auth, no signed URL; it sits in the page's JavaScript either
# way), hence NEXT_PUBLIC_ and inlined at build time. Set another id to swap
# agents, or an empty string to turn the pill off without a code change. The
# call runs on ElevenLabs' browser SDK, a third-party runtime module fetched
# from jsDelivr (pinned @elevenlabs/client 1.25.0, plus livekit-client) on
# click, never on page load (lib/ai-sales.ts).
# NEXT_PUBLIC_ELEVENLABS_AI_SALES_AGENT_ID=agent_3201m2mgwww3fp5s40r1fkgrvfw9
